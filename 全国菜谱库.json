  {
    "id": "xiajiao",
    "name": "虾饺",
    "category": "粤式点心",
    "province": "广东",
    "difficulty": "较难",
    "time_minutes": 60,
    "ingredients": [
      "澄面100g",
      "生粉30g",
      "鲜虾仁200g",
      "肥猪肉丁30g",
      "笋丁50g",
      "盐、糖、白胡椒粉、香油、生粉适量"
    ],
    "steps": [
      "澄面与生粉混合，冲入沸水烫面，揉成透明面团，盖湿布备用。",
      "虾仁拍扁剁成虾胶，加肥丁、笋丁及调味料顺方向搅打上劲。",
      "面团分小剂压成薄皮，包入虾馅，捏成弯梳形。",
      "垫胡萝卜片或油纸，水开上笼大火蒸6-8分钟。"
    ],
    "tips": "面团要趁热包，皮才透明不破；虾仁保留颗粒感更弹牙。"
  },
